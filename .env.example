# MongoDB. Local: `bun run db` (no Docker needed). Production: an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional; defaults to wakacraft (production) / wakacraft-dev.
# MONGODB_DB=wakacraft
# Set to true on Atlas / replica sets so Better Auth can use transactions.
# MONGODB_TRANSACTIONS=true

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app; also shown to users as the plugin api_url.
BETTER_AUTH_URL=http://localhost:3000

# Sign-in is OAuth only (no passwords, no email service).
# GitHub (required): create an OAuth app at https://github.com/settings/developers with callback URL
#   <BETTER_AUTH_URL>/api/auth/callback/github   (e.g. http://localhost:3000/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google (optional; the button appears once set). Callback: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
