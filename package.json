		"cn": "^0.5.0",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.61.0",
		"mongodb": "^7.7.0",
		"mongoose": "^9.8.0",
		"next": "16.4.2",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.8.1",
		"react": "19.3.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "19.3.0",
		"recharts": "3.8.0",
		"server-only": "^0.0.1",
		"shadcn": "^4.22.1",
