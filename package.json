		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.2",
		"json-schema-to-zod": "^2.8.1",
		"mongodb-memory-server": "^11.3.0",
		"mongoose-schema-jsonschema": "4.0.1",
		"prettier": "^3.9.10",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.5"
	},
	"packageManager": "bun@1.4.3",
