{
	"name": "wakacraft",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write --cache .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"sync": "bun ./src/lib/scripts/sync.ts",
		"sync:force": "bun ./src/lib/scripts/sync.ts --force",
		"preflight": "bun run sync && bun run format && bun run typecheck && bun run lint && bun run test && bun run build",
		"db": "bun ./scripts/dev-db.ts",
		"seed:demo": "bun ./scripts/seed-demo.ts"
	},
	"dependencies": {
		"@date-fns/tz": "^1.5.0",
